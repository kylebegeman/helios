=== {App:acme Kind:cron Host: Port:0 Schedule: Postgres:false Dir: Existing:false}
# acme, as helios deploys it.
#
# Anything left out takes its default, and the defaults are the safe
# ones: a read-only root, no capabilities, a non-root user. Run
# `helios deploy` from the directory holding this file.
app: acme
description: What this app is
owner: personal

workloads:
  # A cron workload runs its command on a schedule and exits. It is
  # never given traffic, so it has no port and no routes.
  job:
    kind: cron
    build:
      context: .
    schedule: "0 3 * * *"
    # A run that outlives its timeout is stopped and recorded failed.
    timeout: 30m
    # command: [./app, nightly]
    resources:
      memory: 512m
=== {App:acme Kind:cron Host: Port:0 Schedule:*/15 * * * * Postgres:true Dir: Existing:false}
# acme, as helios deploys it.
#
# Anything left out takes its default, and the defaults are the safe
# ones: a read-only root, no capabilities, a non-root user. Run
# `helios deploy` from the directory holding this file.
app: acme
description: What this app is
owner: personal

workloads:
  # A cron workload runs its command on a schedule and exits. It is
  # never given traffic, so it has no port and no routes.
  job:
    kind: cron
    build:
      context: .
    schedule: "*/15 * * * *"
    # A run that outlives its timeout is stopped and recorded failed.
    timeout: 30m
    # command: [./app, nightly]
    resources:
      memory: 512m

  # A release workload runs once per deploy, after the database is up
  # and before the new revision starts. This is where migrations go.
  # It is commented out because only you know the command; a release
  # step that runs the wrong thing runs it on every single deploy.
