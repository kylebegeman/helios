  #   timeout: 5m

data:
  # Every workload above is given DATABASE_URL pointing here, so
  # nothing else needs declaring to use it. helios generates the
  # password, seals it, and never writes it to a log or a receipt.
  postgres:
    version: "17"

backup:
  # An app with data is backed up nightly by default, with a weekly
  # drill that restores it somewhere safe to prove it opens.
  #
  # A verify query makes a backup prove it holds real rows before it
  # counts. Point it at a table that is never legitimately empty.
  #
  # verify:
  #   sql: select count(*) from users
  #   at_least: 1
