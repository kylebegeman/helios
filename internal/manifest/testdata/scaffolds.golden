=== {App:acme Kind:worker Host: Port:0 Schedule: Postgres:false Dir: Existing:false}
# acme, as helios deploys it.
#
# Anything left out takes its default, and the defaults are the safe
# ones: a read-only root, no capabilities, a non-root user. Run
# `helios deploy` from the directory holding this file.
app: acme
description: What this app is
owner: personal

workloads:
  # A worker runs without listening, so it has no port and no routes.
  worker:
    kind: worker
    build:
      context: .
    # Without a command the image's own CMD runs.
    # command: [./app, worker]
    #
    # singleton keeps the old copy from overlapping the new one
    # during a deploy, for work that must not run twice at once.
    # singleton: true
    resources:
      memory: 512m
